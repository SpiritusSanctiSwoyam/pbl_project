#include <stdio.h>

int main() {
    int rule;
    int binary[8];

    printf("Enter rule number (0-255): ");
    scanf("%d", &rule);

    // Convert rule to binary (8 bits)
    for (int i = 0; i < 8; i++) {
        binary[i] = (rule >> i) & 1;
    }

    printf("\nBoolean Expression:\nF(L,C,R) = ");

    int first = 1;

    // Generate expression
    for (int i = 7; i >= 0; i--) {
        if (binary[i] == 1) {

            if (!first)
                printf(" + ");
            first = 0;

            // L
            if (i & 4)
                printf("L");
            else
                printf("L'");

            // C
            if (i & 2)
                printf("C");
            else
                printf("C'");

            // R
            if (i & 1)
                printf("R");
            else
                printf("R'");
        }
    }

    printf("\n");
    return 0;
}
